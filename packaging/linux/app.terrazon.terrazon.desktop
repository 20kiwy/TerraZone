[Desktop Entry]
Type=Application
Name=TerraZone
GenericName=Vector Graphics Editor
Comment=Draw and edit vector illustrations, SVG and PDF
Exec=terrazon %F
TryExec=terrazon
Icon=app.terrazon.terrazon
Terminal=false
StartupNotify=true
